generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  phone              String             @unique
  password           String
  role               UserRole           @default(USER)
  referralCode       String             @unique
  referredById       String?
  balance            Int                @default(0)
  isActive           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  activation         Activation?
  activationPayments ActivationPayment[]
  taskBalances       TaskBalance[]
  taskSubmissions    TaskSubmission[]
  transactions       Transaction[]
  referredBy         User?              @relation("UserReferrals", fields: [referredById], references: [id])
  referrals          User[]              @relation("UserReferrals")
  withdrawals        Withdrawal[]
}

model Activation {
  id        String                   @id @default(cuid())
  userId    String                   @unique
  amount    Int                      @default(3500)
  status    ActivationStatus         @default(PENDING)
  proof     String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  ActivationPayment[]
}

model ActivationPayment {
  id                String                  @id @default(cuid())
  userId            String
  activationId      String
  providerPaymentId String?                 @unique
  idempotencyKey    String                  @unique
  amount            Int                     @default(3500)
  currency          String                  @default("XOF")
  network           String
  paymentPhone      String
  status            ActivationPaymentStatus @default(PENDING)
  checkoutUrl       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activationId])
  @@index([status])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int
  description String?
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Task {
  id          String           @id @default(cuid())
  title       String           @unique
  description String
  reward      Int              @default(100)
  dayOfWeek   Int
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  balances    TaskBalance[]
  submissions TaskSubmission[]

  @@index([dayOfWeek])
}

model TaskBalance {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
}

model TaskSubmission {
  id        String     @id @default(cuid())
  userId    String
  taskId    String
  taskDate  DateTime   @db.Date
  proof     String?
  status    TaskStatus @default(PENDING)
  reward    Int        @default(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, taskDate])
  @@index([userId])
  @@index([taskId])
  @@index([taskDate])
}

model Withdrawal {
  id        String           @id @default(cuid())
  userId    String
  amount    Int
  fee       Int              @default(500)
  netAmount Int
  method    WithdrawalMethod
  account   String
  source    WithdrawalSource
  taskId    String?
  status    WithdrawalStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([source])
  @@index([taskId])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum UserRole {
  USER
  ADMIN
}

enum ActivationStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum ActivationPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum TransactionType {
  ACTIVATION
  REFERRAL_LEVEL_1
  REFERRAL_LEVEL_2
  REFERRAL_LEVEL_3
  TASK_REWARD
  WITHDRAWAL
  WITHDRAWAL_FEE
}

enum TaskStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalMethod {
  TMONEY
  FLOOZ
  MTN_MOBILE_MONEY
  WAVE
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalSource {
  REFERRAL
  TASK
}
